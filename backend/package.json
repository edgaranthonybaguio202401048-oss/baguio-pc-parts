{
  "name": "baguio-pc-parts-api",
  "version": "1.0.0",
  "description": "Baguio PC Parts – AI-enhanced e-commerce REST API (Express + PostgreSQL + Maya Checkout + Gemini)",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy && npm run db:constraints",
    "db:constraints": "prisma db execute --file prisma/sql/constraints.sql --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed.js",
    "db:reset": "node scripts/reset-dev-db.js",
    "test": "dotenv -e .env.test -- jest --runInBand",
    "audit": "npm audit --omit=dev",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.16.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "setupFiles": ["<rootDir>/tests/setupEnv.js"]
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
