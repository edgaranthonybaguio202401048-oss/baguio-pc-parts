# Copy to .env.test. MUST point at a separate, disposable test database –
# `npm test` resets it on every run.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/baguio_pc_parts_test
JWT_SECRET=test-only-secret-change-me-0123456789
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=4
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PAYMENT_PROVIDER=maya
MAYA_BASE_URL=https://pg-sandbox.paymaya.com
MAYA_PUBLIC_KEY=pk-test
MAYA_SECRET_KEY=sk-test
MAYA_WEBHOOK_TOKEN=test-webhook-token
MAYA_WEBHOOK_ALLOWED_IPS=
AI_PROVIDER=gemini
GEMINI_API_KEY=test-key
AI_TIMEOUT_MS=2000
AI_RATE_LIMIT_PER_15_MIN=1000
