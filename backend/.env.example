# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (no wildcard)
CORS_ORIGINS=http://localhost:5173,https://baguio-pc-parts.vercel.app
# Public URL of the React app (used for Maya redirect URLs)
FRONTEND_URL=http://localhost:5173
# Public HTTPS URL of this API (used in docs and webhook registration)
API_PUBLIC_URL=http://localhost:4000

# ---------- Database (PostgreSQL – Neon or local) ----------
DATABASE_URL=

# ---------- Auth ----------
JWT_SECRET=
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12

# ---------- Payments ----------
# maya (default) | paymongo
PAYMENT_PROVIDER=maya
PAYMENT_CURRENCY=PHP
# Minutes a stock reservation is held while the customer pays
RESERVATION_TTL_MINUTES=30

# Maya Checkout sandbox (https://manager-sandbox.paymaya.com)
MAYA_BASE_URL=https://pg-sandbox.paymaya.com
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
# Long random string. Register the webhook as  <API_PUBLIC_URL>/api/v1/webhooks/maya?token=<MAYA_WEBHOOK_TOKEN>
MAYA_WEBHOOK_TOKEN=
# Maya sandbox webhook source IPs (production: 18.138.50.235,3.1.207.200). Leave empty to disable the IP check.
MAYA_WEBHOOK_ALLOWED_IPS=13.229.160.234,3.1.199.75

# PayMongo (optional second provider – used only if PAYMENT_PROVIDER=paymongo)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# ---------- AI ----------
# gemini (default) | openai
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=12000
AI_MAX_INPUT_CHARS=500
AI_MAX_OUTPUT_TOKENS=800
AI_RATE_LIMIT_PER_15_MIN=20
AI_CACHE_TTL_SECONDS=300
